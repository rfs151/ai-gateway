# 本机（开发机）运行的统一入口：国内 VPS 121.41.221.119 的 80/443 经 frp 原样转发到这里，
# 按子域名转发到本机各项目，证书由 Caddy 自动申请（Let's Encrypt 的验证请求也经 frp 进来）。
# 本机 80/443 被 ZLM 占用，所以监听 8880（HTTP）和 8843（HTTPS）。
# 和服务器版 Caddyfile 的区别只在端口：ZLM 在本机 80，MedLens C++ 后端在本机 8081。
#
#   edgebot.vip         导航页（/srv）+ /status/* 在线状态
#   qt.edgebot.vip      Qt 作品集        127.0.0.1:8080
#   scada.edgebot.vip   PowerGrid SCADA  127.0.0.1:8088
#   ems.edgebot.vip     储能 EMS          127.0.0.1:8095
#   vision.edgebot.vip  ai-vision        127.0.0.1:8090，视频播放路径转给 ZLMediaKit 127.0.0.1:80
#   medlens.edgebot.vip MedLens          127.0.0.1:8010，/cpp/* → C++ 后端 127.0.0.1:8081
#   gvtest.edgebot.vip  ai-gvtest        127.0.0.1:8097
#   http://IP           ZLM 播放路径（直连 IP:8090 的页面用），其他显示导航页
#
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d   （或 ./ctl.sh start）

{
	http_port 8880
	https_port 8843
	# 自动跳转会带上 :8843（外面看到的是 443），改成下面手写的跳转
	auto_https disable_redirects
	# 不开 HTTP/3：它走 UDP 8843，frp 没有转发，浏览器会先试一次再回退
	servers {
		protocols h1 h2
	}
}

(status) {
	handle /status/{args[0]} {
		header Cache-Control no-store
		rewrite * {args[2]}
		reverse_proxy {args[1]} {
			transport http {
				dial_timeout 2s
				response_header_timeout 3s
			}
			@ok status 2xx
			handle_response @ok {
				respond "ok" 200
			}
			handle_response {
				respond "down" 503
			}
		}
	}
}

(nav) {
	encode zstd gzip
	import status qt 127.0.0.1:8080 /healthz
	import status scada 127.0.0.1:8088 /api/health
	import status vision 127.0.0.1:8090 /api/system
	import status medlens 127.0.0.1:8010 /api/health
	import status ems 127.0.0.1:8095 /api/health
	import status gvtest 127.0.0.1:8097 /api/health
	handle_errors 502 503 504 {
		@status path /status/*
		respond @status "down" 503
	}
	handle {
		root * /srv
		file_server
	}
}

# ZLMediaKit 只开放浏览器播放用到的路径：WebRTC 信令、播放器脚本、HTTP-FLV/fMP4、HLS。
# 管理接口 /index/api/*（除 webrtc）不对外。
(zlm) {
	@zlm path_regexp ^(/index/api/webrtc|/ZLMRTCClient\.js|/[^/]+/[^/]+\.live\.(mp4|flv)|/[^/]+/[^/]+/.*\.(m3u8|ts))$
	handle @zlm {
		reverse_proxy 127.0.0.1:80 {
			flush_interval -1 # 直播流边收边发，不缓冲
		}
	}
}

# http 子域名一律跳 https（不带端口）
http://edgebot.vip, http://*.edgebot.vip {
	redir https://{host}{uri} permanent
}

edgebot.vip {
	import nav
}

www.edgebot.vip {
	redir https://edgebot.vip{uri} permanent
}

qt.edgebot.vip {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
}

ems.edgebot.vip {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8095
}

scada.edgebot.vip {
	# SCADA 自带的 Caddy 已经压缩、加安全响应头，这里只转发（含 WebSocket /ws）
	reverse_proxy 127.0.0.1:8088
}

vision.edgebot.vip {
	import zlm
	# 页面、API、WebSocket /ws、告警截图和录像 /media（ai-vision 自己做 gzip）
	handle {
		reverse_proxy 127.0.0.1:8090
	}
}

medlens.edgebot.vip {
	encode zstd gzip
	# C++ 后端（https 页面切换后端时用）：/cpp/api/... -> 127.0.0.1:8081/api/...
	handle_path /cpp/* {
		reverse_proxy 127.0.0.1:8081
	}
	handle {
		reverse_proxy 127.0.0.1:8010
	}
}

gvtest.edgebot.vip {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8097
}

# 直接用 IP 访问：http://IP:8090 打开的 ai-vision 页面从这里（VPS 80 端口）拉视频，其他显示导航页
http:// {
	import zlm
	import nav
}
